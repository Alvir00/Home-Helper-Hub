# Copy to .env and fill in. Values here are safe placeholders, not secrets.

# Postgres connection string — required by the API and by drizzle-kit.
DATABASE_URL=postgres://meraki:meraki@localhost:5432/meraki

# Port the API listens on. Required: the server and every vite.config.ts throw
# when it is missing.
PORT=8080

# Public path the web app is served from. Baked into asset URLs at build time
# and required by the vite configs; "/" when the site is at the domain root.
BASE_PATH=/

# Directory containing the built SPA. When set, the API also serves the web app
# so the site and API share one origin (needed for sameSite=lax session cookies).
# Leave empty to disable, which is what Replit does.
WEB_DIST=

# Extra browser origins allowed to call the API, comma separated. Same-host
# origins are always allowed; unset means only same-host in production.
ALLOWED_ORIGINS=

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Public base URL used in password-reset links. Falls back to the request host
# when unset, which is wrong behind a proxy — set it in production.
APP_URL=http://localhost:8080

# Transactional email (password reset). Without a key, reset requests still
# succeed but the link is only logged, and only outside production.
# RESEND_API_KEY=
# MAIL_FROM=Meraki <no-reply@yourdomain.com>

# Replit Auth OIDC (optional). Email/password sign-in needs none of this; set
# REPL_ID only if you also want the Replit login path enabled.
# REPL_ID=
# ISSUER_URL=https://replit.com/oidc
