# Copy to `.env` for Docker Compose on a VPS, then fill in real values.
# Never commit `.env` — it is ignored by git.

# Public URL used in email links, canonical tags and the sitemap.
APP_URL=https://meraki.example.com

# Leave DATABASE_URL unset to use the bundled Postgres container.
# Set it to use a managed database (Neon, Render, Railway, RDS...).
# DATABASE_URL=postgres://user:password@host:5432/meraki?sslmode=require

# Transactional email (resend.com). Without a key, emails are logged and skipped.
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=Meraki <no-reply@meraki.example.com>
# BOOKING_NOTIFY_EMAIL=bookings@meraki.example.com

# Optional Slack/Discord webhook for fatal-error alerts.
# ERROR_WEBHOOK_URL=https://hooks.slack.com/services/...

# Extra browser origins allowed to call the API (comma-separated).
# ALLOWED_ORIGINS=https://www.meraki.example.com

# Seed-only: creates the first admin.
#   docker compose --profile tools run --rm seed
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=use-a-password-manager
# Demo helpers/reviews are opt-in. Leave 0/unset on a real launch.
# SEED_DEMO_DATA=0

# Keep 0 in production: 1 activates paid plans without payment.
ALLOW_UNPAID_SUBSCRIPTIONS=0

# Local development without Docker (the image sets these itself):
# PORT=8080
# BASE_PATH=/
# WEB_DIST=
# REPL_ID=
# ISSUER_URL=https://replit.com/oidc
