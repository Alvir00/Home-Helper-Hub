# Caddy reverse proxy for a single VPS.
#
# Caddy obtains and renews a Let's Encrypt certificate automatically, adds
# HTTP/2 + gzip/zstd, and forwards traffic to the app container. Replace
# `meraki.example.com` with your domain and point its A/AAAA record at the
# server before starting Caddy.
#
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# The app already sends CSP and security headers; Caddy adds HSTS here because
# it is the only component that knows TLS is terminated in front of the app.

meraki.example.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy 127.0.0.1:8080 {
		header_up X-Forwarded-Proto {scheme}
		health_uri /api/healthz
		health_interval 30s
	}

	log {
		output file /var/log/caddy/meraki.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
